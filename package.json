{
  "name": "attack-gallery",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w web && node --test scripts/*.test.mjs",
    "build": "npm run build -w web",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "e2e": "node scripts/e2e.mjs",
    "docs": "node scripts/build-docs.mjs",
    "content-pack": "node scripts/build-content-pack.mjs && node scripts/validate-content-pack.mjs",
    "live-check": "node scripts/live-check.mjs"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.64.1"
  }
}
